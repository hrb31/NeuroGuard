{
  "experiment": "bce",
  "seed": 42,
  "model": {"in_channels": 3, "base_channels": 16},
  "preprocessing": {"size": 256, "channels": [0, 1, 2]},
  "batch_size": 16,
  "num_workers": 2,
  "optimizer": {"name": "Adam", "lr": 0.001, "weight_decay": 0.0},
  "max_epochs": 30,
  "patience": 7,
  "min_delta": 0.0001,
  "checkpoint_threshold": 0.5,
  "thresholds": [0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9],
  "empty_fp_limit": 0.1,
  "comparison_fp_increase_limit": 0.05,
  "loss": "BCEWithLogitsLoss(mean)",
  "augmentation": "joint horizontal flip p=.5; rotation +/-10 degrees p=.5; training only",
  "normalization": "per-image/channel nonzero z-score after geometry; constant -> zero",
  "precision": "float32",
  "deterministic_algorithms": true
}
